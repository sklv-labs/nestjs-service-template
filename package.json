{
  "name": "nestjs-service-template",
  "version": "0.0.0",
  "private": true,
  "description": "Playground for working out the NestJS service architecture at sklv-labs",
  "author": "sklv-labs",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist coverage *.tsbuildinfo packages/*/dist packages/*/*.tsbuildinfo",
    "start": "node dist/src/main.js",
    "start:dev": "pnpm build && concurrently -k -n tsc,app -c blue,green \"tsc -b --watch\" \"node --watch dist/src/main.js\"",
    "type-check": "tsc -b --force && tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "openapi": "pnpm build && node --env-file-if-exists=.env.example dist/scripts/generate-openapi.js",
    "bruno:generate": "pnpm openapi && node dist/scripts/generate-bruno.js",
    "bruno:run": "cd bruno && bru run -r",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@sklv-labs/core": "^0.1.1",
    "@sklv-labs/nestjs-config": "^0.2.1",
    "@sklv-labs/nestjs-core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nestjs-cls": "^6.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sklv-labs/dev-configs": "^0.2.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@usebruno/cli": "^4.1.0",
    "@usebruno/converters": "^0.23.0",
    "@usebruno/lang": "^0.39.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-editor": "npm:typescript@^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
