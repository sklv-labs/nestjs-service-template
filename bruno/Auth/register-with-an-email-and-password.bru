meta {
  name: Register with an email and password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

headers {
  @description('Correlation id (UUID). Generated when absent or not a UUID.')
  ~x-request-id: 
}

body:json {
  {
    "email": "alex@example.com",
    "password": "correct-horse-battery-staple"
  }
}

vars:post-response {
  userId: res.body.id
}

docs {
  Creates an account and attaches a password as its first sign-in method.
}
