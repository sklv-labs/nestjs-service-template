auth {
  mode: none
}

script:pre-request {
  // Generated bodies carry the contract's example address, so a second run would collide with the
  // first. Uniquifying here keeps the collection re-runnable against a database that already holds
  // data: CI starts clean, a laptop does not.
  const body = req.getBody();

  if (body && typeof body === "object" && typeof body.email === "string") {
    body.email = body.email.replace("@", `+bru-${Date.now()}@`);
    req.setBody(body);
  }
}

script:post-response {
  // Requests are regenerated from openapi.json, so nothing hand-written may live in them.
  // Collection-level scripts and tests survive regeneration; this file is the place for them.
}

tests {
  test("responds without a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });

  test("carries a correlation id", function () {
    // Every response echoes it, generated when the caller sends none — so a missing header means
    // the request never reached the application.
    expect(res.getHeader("x-request-id")).to.be.a("string");
  });

  test("answers with json", function () {
    expect(res.getHeader("content-type")).to.contain("application/json");
  });

  test("sends no unresolved template variables", function () {
    // An undefined variable is left in the url verbatim, and every other assertion here still
    // passes — a 404 is under 500, is json, and is fast. Without this the collection can be green
    // while exercising nothing.
    expect(req.getUrl()).to.not.contain("{{");
  });

  test("responds within the budget", function () {
    expect(res.getResponseTime()).to.be.below(2000);
  });
}
