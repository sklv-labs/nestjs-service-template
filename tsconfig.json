{
  "extends": "@sklv-labs/dev-configs/tsconfig/nestjs.json",
  "compilerOptions": {
    // `.` rather than `./src`, because `scripts/` is compiled too — which is why the entrypoint is
    // `dist/src/main.js`. Setting it explicitly keeps the layout stable when only `src` is present,
    // as in the Docker build, where an inferred root would collapse to `dist/main.js`.
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["**/*.test.ts"],
  // Compiles against the package's emitted declarations, not its sources — so the service is a
  // consumer like any other, and `tsc -b` builds the package first.
  "references": [{ "path": "./packages/nestjs-core" }]
}
